# Required: your bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# Optional: on startup, sets this channel as the results channel of the server that has none yet.
# After that, each server manages its own channel with /settings channel.
CHANNEL_ID=

# Optional: server ID(s) where the slash commands appear instantly.
GUILD_ID=

# Optional: default timezone for servers that haven't chosen one (default: UTC)
TIMEZONE=UTC

# Optional
DB_PATH=daily.db
BACKFILL_LIMIT=500